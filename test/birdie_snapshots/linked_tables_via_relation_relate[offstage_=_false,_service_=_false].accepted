---
version: 2.0.2
title: LinkedTablesViaRelationRelate[offstage = False, service = False]
file: ./test/sample/linked_tables_via_relation_relate.gleam
test_name: linked_tables_via_relation_relate_test
---
import db/test/linked_table_a
import db/test/linked_table_b
import db/test/linked_table_c
import suweal/identifier
import suweal/node
import suweal/record
import suweal/surreal_ql

pub type QueryResult = linked_table_c.C

pub const decoder = linked_table_c.decoder

pub const to_json = linked_table_c.to_json

pub fn parameters(
  a a: record.Record(linked_table_a.A),
  b b: record.Record(linked_table_b.B),
) -> List(#(String, surreal_ql.SurrealQL)) {
  [
    #("a", surreal_ql.Raw(identifier.to_string(a.id))),
    #("b", surreal_ql.Raw(identifier.to_string(b.id))),
  ]
}

// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //
//                                 Raw query                                  //
// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //

pub const query_string = "RELATE $a->c->$b;\n"

pub const query_node = [
  node.Relate(
    table: "c",
    from: node.Parameter("a"),
    to: node.Parameter("b"),
    set: [],
  ),
]
