---
version: 2.0.2
title: SimpleCreateUser[backstage = True, service = True]
file: ./test/sample/simple_create_user.gleam
test_name: simple_create_user_with_service_test
---
import db/test/simple_user_table
import gleam/option
import offstage/dynamic/serialize
import suweal/node
import suweal/surreal_ql
import suweal_service
import suweal_service/query

pub type QueryResult = simple_user_table.User

pub const serializer = simple_user_table.serializer

pub const to_json = simple_user_table.to_json

pub fn parameters(username username: String, email email: String) -> List(#(String, surreal_ql.SurrealQL)) {
  [
    #("username", surreal_ql.String(username)),
    #("email", surreal_ql.String(email)),
  ]
}

pub fn query(username username: String, email email: String) -> query.Query(List(QueryResult), option.Option(List(QueryResult))) {
  query.query(
    resource: simple_user_table.table_name,
    operation_type: suweal_service.Create,
    query: query_node,
    serializer: serialize.list(serializer()),
    parameters: parameters(username: username, email: email),
  )
}

// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //
//                                 Raw query                                  //
// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //

pub const query_string = "CREATE user SET username = $username, email = $email;\n"

pub const query_node = [
  node.Create(
    only: False,
    target: "user",
    set: [
      node.BinaryOperator(
        lhs: node.Identifier("username"),
        operator: node.Equal,
        rhs: node.Parameter("username"),
      ),
      node.BinaryOperator(
        lhs: node.Identifier("email"),
        operator: node.Equal,
        rhs: node.Parameter("email"),
      ),
    ],
  ),
]
