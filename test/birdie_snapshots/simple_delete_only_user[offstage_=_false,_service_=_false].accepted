---
version: 2.0.2
title: SimpleDeleteOnlyUser[offstage = False, service = False]
file: ./test/sample/simple_delete_only_user.gleam
test_name: simple_delete_only_user_test
---
import db/test/simple_user_table
import gleam/dynamic/decode
import gleam/json
import gleam/option
import suweal/identifier
import suweal/node
import suweal/surreal_ql

pub type QueryResult = Nil

pub const to_json = json.null

pub fn decoder() {
  decode.success(Nil)
}

pub fn parameters(id id: identifier.Identifier(simple_user_table.User)) -> List(#(String, surreal_ql.SurrealQL)) {
  [#("id", surreal_ql.Raw(identifier.to_string(id)))]
}

// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //
//                                 Raw query                                  //
// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //

pub const query_string = "DELETE ONLY user WHERE id = $id;\n"

pub const query_node = [
  node.Delete(
    only: True,
    target: node.Identifier("user"),
    where: option.Some(
      node.BinaryOperator(
        lhs: node.Identifier("id"),
        operator: node.Equal,
        rhs: node.Parameter("id"),
      ),
    ),
  ),
]
