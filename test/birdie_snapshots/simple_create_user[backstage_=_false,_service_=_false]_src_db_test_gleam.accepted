---
version: 2.0.2
title: SimpleCreateUser[backstage = False, service = False] : ./src/db/test.gleam
---
import gleam/dynamic/decode
import gleam/json
import gleam/option
import suweal/identifier
import suweal/node
import suweal/surreal_ql
import suweal/surreal_type
import suweal/table_spec

pub const table_name = "user"

// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //
//                                    User                                    //
// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //

pub type User {
  User(
    id: identifier.Identifier(User),
    username: String,
    email: String,
    password: String,
  )
}

pub fn decoder() -> decode.Decoder(User) {
  use password <- decode.field("password", decode.string)
  use email <- decode.field("email", decode.string)
  use username <- decode.field("username", decode.string)
  use id <- decode.field("id", identifier.typed_decoder([table_name]))
  decode.success(User(id, username, email, password))
}

pub fn to_json(self: User) -> json.Json {
  json.object(
    [
      #("id", self.id |> identifier.to_string |> json.string),
      #("username", json.string(self.username)),
      #("email", json.string(self.email)),
      #("password", json.string(self.password)),
    ],
  )
}

pub fn to_surql(self: User) -> surreal_ql.SurrealQL {
  surreal_ql.Object(
    [
      #("username", surreal_ql.String(self.username)),
      #("email", surreal_ql.String(self.email)),
      #("password", surreal_ql.String(self.password)),
    ],
  )
}

pub fn specs() -> table_spec.GleamTableSpec(User) {
  table_spec.TableSpec(
    table_name: table_name,
    query_string: query_string,
    query: query_node,
    id: fn(value: User) {
      identifier.Identifier(value.id.type_, value.id.id)
    },
    to_surql: to_surql,
    to_json: to_json,
    serializer: decoder,
  )
}

// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //
//                                 Raw query                                  //
// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //

pub const query_string = "DEFINE TABLE user TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;\n"
<> "\n"
<> "DEFINE FIELD username ON user TYPE string DEFAULT NONE PERMISSIONS FULL;\n"
<> "DEFINE FIELD email ON user TYPE string DEFAULT NONE PERMISSIONS FULL;\n"
<> "DEFINE FIELD password ON user TYPE string PERMISSIONS FULL;\n"
<> "\n"

pub const query_node = [
  node.DefineTable(
    name: "user",
    schema: node.Schemafull,
    type_: node.NormalTable,
    permissions: [node.PermissionNone],
    as_: option.None,
  ),
  node.DefineField(
    name: node.Identifier("username"),
    table: "user",
    type_: surreal_type.String,
    default: option.Some(node.None),
    assert_: option.None,
    permissions: [node.PermissionFull],
    flexible: False,
  ),
  node.DefineField(
    name: node.Identifier("email"),
    table: "user",
    type_: surreal_type.String,
    default: option.Some(node.None),
    assert_: option.None,
    permissions: [node.PermissionFull],
    flexible: False,
  ),
  node.DefineField(
    name: node.Identifier("password"),
    table: "user",
    type_: surreal_type.String,
    default: option.None,
    assert_: option.None,
    permissions: [node.PermissionFull],
    flexible: False,
  ),
]
