---
version: 2.0.2
title: SimpleSelectFieldsUser[offstage = True, service = False]
file: ./test/sample/simple_fields_select_user.gleam
test_name: simple_select_fields_user_with_backstage_test
---
import db/test/simple_user_table
import gleam/json
import gleam/option
import offstage/dynamic/encode
import offstage/dynamic/serialize
import suweal/node

// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //
//                                Query result                                //
// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //

pub type QueryResult {
  QueryResult(
    username: String,
    email: String,
  )
}

pub fn serializer() -> serialize.Serializer(QueryResult) {
  serialize.object(
    fn(context) {
      use context, username <- serialize.field(
        context,
        "username",
        serialize.string(),
        fn(data: QueryResult) {
          data.username
        },
      )
      use context, email <- serialize.field(
        context,
        "email",
        serialize.string(),
        fn(data: QueryResult) {
          data.email
        },
      )
      serialize.build(context, QueryResult(username: username, email: email))
    },
  )
}

pub fn to_json(self: QueryResult) -> json.Json {
  encode.encode_json(self, serialize.encoder(serializer()))
}

// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //
//                                 Raw query                                  //
// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //

pub const query_string = "SELECT username, email FROM user;\n"

pub const query_node = [
  node.Select(
    fields: [
      node.SelectField(
        field: node.Identifier("username"),
        alias: option.None,
        value: False,
      ),
      node.SelectField(
        field: node.Identifier("email"),
        alias: option.None,
        value: False,
      ),
    ],
    only: False,
    table: "user",
    where: option.None,
    order: option.None,
    limit: option.None,
    group_all: False,
  ),
]
