import gleam/option
import gleam/time/timestamp
import offstage/dynamic/serialize
import suweal/identifier
import suweal/point
import suweal/record
import suweal/surreal_ql
import suweal_service
import suweal_service/query

pub fn query(
  s s: String,
  i i: Int,
  f f: Float,
  b b: Bool,
  a a: List(String),
  d d: timestamp.Timestamp,
  o o: option.Option(String),
  id id: identifier.Identifier(user),
  rc rc: record.Record(id),
  obj obj: surreal_ql.SurrealQL,
  nested_obj nested_obj: surreal_ql.SurrealQL,
  p p: point.Point,
  e e: enum,
) -> query.Query(List(ResultType), option.Option(List(ResultType))) {
  query.query(
    resource: prefix.table_name,
    operation_type: suweal_service.Create,
    query: query_node,
    serializer: serialize.list(serializer()),
    parameters: parameters(
      s: s,
      i: i,
      f: f,
      b: b,
      a: a,
      d: d,
      o: o,
      id: id,
      rc: rc,
      obj: obj,
      nested_obj: nested_obj,
      p: p,
      e: e,
    ),
  )
}
