---
version: 2.0.2
title: CreateWithNestedFields[offstage = True, service = False]
file: ./test/sample/create_with_nested_fields_test.gleam
test_name: create_with_nested_fields_with_offstage_test
---
import db/test/table_with_nested_fields
import suweal/node
import suweal/surreal_ql

pub type QueryResult = table_with_nested_fields.Post

pub const serializer = table_with_nested_fields.serializer

pub const to_json = table_with_nested_fields.to_json

pub fn parameters(meta meta: table_with_nested_fields.Meta) -> List(#(String, surreal_ql.SurrealQL)) {
  [#("meta", table_with_nested_fields.meta_to_surql(meta))]
}

// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //
//                                 Raw query                                  //
// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //

pub const query_string = "CREATE post SET meta = $meta;\n"

pub const query_node = [
  node.Create(
    only: False,
    target: "post",
    set: [
      node.BinaryOperator(
        lhs: node.Identifier("meta"),
        operator: node.Equal,
        rhs: node.Parameter("meta"),
      ),
    ],
  ),
]
