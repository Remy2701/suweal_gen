title: table_spec_generation_with_offstage_test
file: ./test/builder/table_spec_test.gleam
test_name: table_spec_generation_with_offstage_test
---
import offstage_suweal/table_spec as bs_table_spec
import suweal/table_spec

pub fn specs() -> bs_table_spec.TableSpec(User) {
  table_spec.TableSpec(
    table_name: table_name,
    query_string: query_string,
    query: query_node,
    id: fn(value: User) {
      identifier.Identifier(value.id.type_, value.id.id)
    },
    to_surql: to_surql,
    to_json: to_json,
    serializer: serializer,
  )
}
