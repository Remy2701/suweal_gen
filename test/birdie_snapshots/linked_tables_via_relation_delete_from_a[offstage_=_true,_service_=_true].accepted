---
version: 2.0.2
title: LinkedTablesViaRelationDeleteFromA[offstage = True, service = True]
file: ./test/sample/linked_tables_via_relation_delete.gleam
test_name: linked_tables_via_relation_delete_from_a_with_service_test
---
import db/test/linked_table_a
import db/test/linked_table_b
import db/test/linked_table_c
import gleam/json
import gleam/option
import offstage/dynamic/serialize
import suweal/identifier
import suweal/node
import suweal/record
import suweal/surreal_ql
import suweal_service
import suweal_service/query

pub type QueryResult = Nil

pub const to_json = json.null

pub fn serializer() {
  serialize.nil()
}

pub fn parameters(a a: identifier.Identifier(linked_table_a.A)) -> List(#(String, surreal_ql.SurrealQL)) {
  [#("a", surreal_ql.Raw(identifier.to_string(a)))]
}

pub fn query(a a: identifier.Identifier(linked_table_a.A)) -> query.Query(List(QueryResult), option.Option(List(QueryResult))) {
  query.query(
    resource: linked_table_c.table_name,
    operation_type: suweal_service.Delete,
    query: query_node,
    serializer: serialize.list(serializer()),
    parameters: parameters(a: a),
  )
}

// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //
//                                 Raw query                                  //
// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //

pub const query_string = "DELETE $a->c;\n"

pub const query_node = [
  node.Delete(
    only: False,
    target: node.BinaryOperator(
      lhs: node.Parameter("a"),
      operator: node.RelationTo,
      rhs: node.Identifier("c"),
    ),
    where: option.None,
  ),
]
