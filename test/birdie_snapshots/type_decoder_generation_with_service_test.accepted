---
version: 2.0.2
title: type_decoder_generation_with_service_test
file: ./test/builder/type_decoder_test.gleam
test_name: type_decoder_generation_with_service_test
---
import gleam/option
import offstage/dynamic/serialize
import offstage_suweal/identifier as os_identifier
import offstage_suweal/point as os_point
import offstage_suweal/record as os_record

pub fn serializer() -> serialize.Serializer(User) {
  serialize.object(
    fn(context) {
      use context, s <- serialize.field(
        context,
        "s",
        serialize.string(),
        fn(data: User) {
          data.s
        },
      )
      use context, i <- serialize.field(
        context,
        "i",
        serialize.int(),
        fn(data: User) {
          data.i
        },
      )
      use context, f <- serialize.field(
        context,
        "f",
        serialize.float(),
        fn(data: User) {
          data.f
        },
      )
      use context, b <- serialize.field(
        context,
        "b",
        serialize.bool(),
        fn(data: User) {
          data.b
        },
      )
      use context, a <- serialize.field(
        context,
        "a",
        serialize.list(serialize.string()),
        fn(data: User) {
          data.a
        },
      )
      use context, d <- serialize.field(
        context,
        "d",
        serialize.timestamp(),
        fn(data: User) {
          data.d
        },
      )
      use context, o <- serialize.optional_field(
        context,
        "o",
        option.None,
        serialize.optional(serialize.string()),
        fn(data: User) {
          data.o
        },
      )
      use context, id <- serialize.field(
        context,
        "id",
        os_identifier.typed_serializer([table_name]),
        fn(data: User) {
          data.id
        },
      )
      use context, rc <- serialize.field(
        context,
        "rc",
        os_record.typed_serializer(
          id.serializer(),
          fn(data) {
            data.id
          },
          [table_name],
        ),
        fn(data: User) {
          data.rc
        },
      )
      use context, obj <- serialize.field(
        context,
        "obj",
        serialize.json_value(),
        fn(data: User) {
          data.obj
        },
      )
      use context, nested_obj <- serialize.field(
        context,
        "nested_obj",
        nested_obj_serializer(),
        fn(data: User) {
          data.nested_obj
        },
      )
      use context, p <- serialize.field(
        context,
        "p",
        os_point.serializer(),
        fn(data: User) {
          data.p
        },
      )
      use context, e <- serialize.field(
        context,
        "e",
        enum_serializer(),
        fn(data: User) {
          data.e
        },
      )
      serialize.build(
        context,
        User(
          s: s,
          i: i,
          f: f,
          b: b,
          a: a,
          d: d,
          o: o,
          id: id,
          rc: rc,
          obj: obj,
          nested_obj: nested_obj,
          p: p,
          e: e,
        ),
      )
    },
  )
}
