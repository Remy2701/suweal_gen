// [./src/db/test/linked_table_c.gleam]
import db/test/linked_table_a
import db/test/linked_table_b
import gleam/dynamic/decode
import gleam/json
import gleam/option
import suweal/identifier
import suweal/node
import suweal/record
import suweal/surreal_ql
import suweal/surreal_type
import suweal/table_spec

pub const table_name = "c"

// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //
//                                     C                                      //
// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //

pub type C {
  C(
    id: identifier.Identifier(C),
    in: record.Record(linked_table_a.A),
    out: record.Record(linked_table_b.B),
  )
}

pub fn decoder() -> decode.Decoder(C) {
  use out <- decode.field(
    "out",
    record.typed_decoder(
      linked_table_b.decoder(),
      fn(data) {
        data.id
      },
      [linked_table_b.table_name],
    ),
  )
  use in <- decode.field(
    "in",
    record.typed_decoder(
      linked_table_a.decoder(),
      fn(data) {
        data.id
      },
      [linked_table_a.table_name],
    ),
  )
  use id <- decode.field("id", identifier.typed_decoder([table_name]))
  decode.success(C(id, in, out))
}

pub fn to_json(self: C) -> json.Json {
  json.object(
    [
      #("id", self.id |> identifier.to_string |> json.string),
      #("in", self.in |> record.to_json(linked_table_a.to_json)),
      #("out", self.out |> record.to_json(linked_table_b.to_json)),
    ],
  )
}

pub fn to_surql(self: C) -> surreal_ql.SurrealQL {
  surreal_ql.Object(
    [
      #("in", self.in |> record.to_surql(linked_table_a.to_surql)),
      #("out", self.out |> record.to_surql(linked_table_b.to_surql)),
    ],
  )
}

pub fn specs() -> table_spec.GleamTableSpec(C) {
  table_spec.TableSpec(
    table_name: table_name,
    query_string: query_string,
    query: query_node,
    id: fn(value: C) {
      identifier.Identifier(value.id.type_, value.id.id)
    },
    to_surql: to_surql,
    to_json: to_json,
    serializer: decoder,
  )
}

// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //
//                                 Raw query                                  //
// –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––– //

pub const query_string = "DEFINE TABLE c TYPE RELATION IN a OUT b SCHEMAFULL PERMISSIONS NONE;\n"
<> "\n"
<> "DEFINE FIELD in ON c TYPE record<a> DEFAULT NONE PERMISSIONS FULL;\n"
<> "DEFINE FIELD out ON c TYPE record<b> DEFAULT NONE PERMISSIONS FULL;\n"
<> "\n"

pub const query_node = [
  node.DefineTable(
    name: "c",
    schema: node.Schemafull,
    type_: node.RelationTable(in: "a", out: "b"),
    permissions: [node.PermissionNone],
    as_: option.None,
  ),
  node.DefineField(
    name: node.Identifier("in"),
    table: "c",
    type_: surreal_type.Record("a"),
    default: option.Some(node.None),
    assert_: option.None,
    permissions: [node.PermissionFull],
    flexible: False,
  ),
  node.DefineField(
    name: node.Identifier("out"),
    table: "c",
    type_: surreal_type.Record("b"),
    default: option.Some(node.None),
    assert_: option.None,
    permissions: [node.PermissionFull],
    flexible: False,
  ),
]
